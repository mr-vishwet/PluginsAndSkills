{
  "name": "__NAME__",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  }

  // Add bindings as needed. All of these are free-tier:
  //
  // "kv_namespaces": [{ "binding": "CACHE", "id": "<from: wrangler kv namespace create CACHE>" }],
  // "d1_databases": [{ "binding": "DB", "database_name": "__NAME__-db", "database_id": "<from: wrangler d1 create>" }],
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "__NAME__-media" }],
  // "vars": { "ALLOWED_ORIGIN": "https://__NAME__.workers.dev" }
}
