# Shape of ~/.fcc/.env for free-claude-code 6.19.2.
# Values are managed by FCC; the admin UI at /admin writes most of them.
# Key fields are JSON arrays of strings, not bare strings.
FCC_CONFIG_SCHEMA=2

HTTP_CONNECT_TIMEOUT=120.0
MODEL_FALLBACKS="[{\"model\":\"open_router/openrouter/free\",\"reasoning\":\"inherit\",\"api_key_number\":1}]"

NVIDIA_NIM_API_KEY="[\"REPLACE_ME_NVIDIA_NIM_API_KEY\"]"
OPENROUTER_API_KEY="[\"REPLACE_ME_OPENROUTER_API_KEY\"]"

PROVIDER_MAX_CONCURRENCY=10000
PROVIDER_RATE_LIMIT=10000
PROVIDER_RATE_WINDOW=100
