{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "oauth": {}
    },
    "firefox-devtools": {
      "type": "local",
      "command": ["npx", "-y", "@mozilla/firefox-devtools-mcp", "--connect-existing", "--marionette-port", "2828"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "playwright-chrome": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser", "chrome", "--user-data-dir", "C:/Users/User/AppData/Local/Google/Chrome/User Data"],
      "enabled": true
    },
    "playwright-firefox": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser", "firefox"],
      "enabled": false
    },
    "playwright-headless": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless"],
      "enabled": true
    }
  },
  "disabled_providers": []
}
