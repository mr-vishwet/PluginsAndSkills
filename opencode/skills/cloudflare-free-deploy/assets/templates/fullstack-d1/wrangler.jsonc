{
  "name": "__NAME__",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__NAME__-db",
      "database_id": "REPLACE_WITH_DATABASE_ID"
    }
  ],

  "vars": {
    "TURNSTILE_SITE_KEY": ""
  }
}
